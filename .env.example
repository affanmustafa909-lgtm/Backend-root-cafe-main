# Database (host port 5434 — avoid conflict with local Postgres on 5432/5433)
DATABASE_URL=postgresql://roots:roots@localhost:5434/roots_cafe?schema=public

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# API
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081
API_URL=http://localhost:3000

# Features
ENABLE_REPORTING=true

# Business defaults (V1 temporary until confirmed)
TAX_RATE=0
CURRENCY=EUR
TIMEZONE=Europe/Dublin

# Pickup scheduling (customer app)
PICKUP_OPEN_TIME=08:00
PICKUP_CLOSE_TIME=18:00
PICKUP_SLOT_INTERVAL_MINUTES=15
PICKUP_MAX_DAYS_AHEAD=7
ASAP_ESTIMATE_MINUTES=10

# Uploads
UPLOAD_DIR=./uploads

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Seed
SEED_MANAGER_EMAIL=manager@rootscafe.local
SEED_STAFF_EMAIL=staff@rootscafe.local
SEED_CUSTOMER_EMAIL=customer@rootscafe.local
SEED_PASSWORD=Password123!
