generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
}

enum PaymentMethod {
  PAY_AT_CAFE
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PickupType {
  ASAP
  SCHEDULED
}

enum SelectionType {
  SINGLE
  MULTI
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  role         Role
  accountStatus AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orders        Order[]
  deviceTokens  DeviceToken[]
  notifications Notification[]

  @@index([role])
  @@index([email])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  allergens   String?
  isAvailable     Boolean  @default(true)
  isSoldOut       Boolean  @default(false)
  isTopSale       Boolean  @default(false)
  discountPercent Int?
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category             Category                    @relation(fields: [categoryId], references: [id])
  customizationGroups  ProductCustomizationGroup[]
  orderItems           OrderItem[]
  cakesOfTheDay        CakeOfTheDay[]

  @@index([categoryId])
  @@index([isActive, isSoldOut, sortOrder])
}

model CustomizationGroup {
  id            String                @id @default(cuid())
  name          String
  isRequired    Boolean               @default(false)
  selectionType SelectionType         @default(SINGLE)
  maxSelections Int?
  sortOrder     Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  options       CustomizationOption[]
  products      ProductCustomizationGroup[]

  @@index([isActive, sortOrder])
}

model CustomizationOption {
  id              String             @id @default(cuid())
  groupId         String
  name            String
  additionalPrice Decimal            @default(0) @db.Decimal(10, 2)
  isAvailable     Boolean            @default(true)
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  group           CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemCustomizations OrderItemCustomization[]

  @@index([groupId, sortOrder])
}

model ProductCustomizationGroup {
  id        String             @id @default(cuid())
  productId String
  groupId   String
  sortOrder Int                @default(0)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([productId, groupId])
  @@index([productId])
}

model CakeOfTheDay {
  id          String   @id @default(cuid())
  productId   String?
  date        DateTime @db.Date
  title       String?
  description String?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product? @relation(fields: [productId], references: [id])

  @@index([date, isActive])
}

/** Singleton row (id = "default") for customer-app home + pickup settings. */
model AppConfig {
  id                    String   @id @default("default")
  homeBannerImageUrl    String?
  onboardingCtaText     String?  @default("Get Started")
  pickupOpenTime        String?
  pickupCloseTime       String?
  pickupSlotIntervalMin Int?
  pickupMaxDaysAhead    Int?
  asapEstimateMinutes   Int?
  updatedAt             DateTime @updatedAt
}

model OnboardingSlide {
  id                String   @id @default(cuid())
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  imageUrl          String?
  title             String
  body              String
  titlePlacement    String   @default("top")
  titleAlign        String   @default("center")
  bodyAlign         String   @default("center")
  copyBlockVertical String   @default("bottom")
  showBottomShadow  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String
  status        OrderStatus   @default(RECEIVED)
  pickupType    PickupType
  pickupDate    DateTime?     @db.Date
  pickupTime    String?
  paymentMethod PaymentMethod @default(PAY_AT_CAFE)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  notes         String?
  statusChangedAt DateTime    @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer User        @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([pickupType])
  @@index([pickupDate])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String?
  productNameSnapshot String
  unitPriceSnapshot  Decimal  @db.Decimal(10, 2)
  quantity           Int
  lineTotal          Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())

  order          Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  customizations OrderItemCustomization[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemCustomization {
  id                      String  @id @default(cuid())
  orderItemId             String
  optionId                String?
  groupNameSnapshot       String
  optionNameSnapshot      String
  additionalPriceSnapshot Decimal @db.Decimal(10, 2)

  orderItem OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    CustomizationOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  payload   Json?
  status    NotificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
